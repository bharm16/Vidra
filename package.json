{
  "name": "vidra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "imports": {
    "#shared/*": "./shared/*",
    "#tests/*": "./tests/*"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@fal-ai/client": "^1.8.4",
    "@google-cloud/storage": "^7.19.0",
    "@huggingface/transformers": "^3.8.0",
    "@promptstudio/system": "workspace:*",
    "ahocorasick": "^1.0.2",
    "compression": "^1.8.1",
    "compromise": "^14.14.5",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "file-type": "^21.3.4",
    "firebase": "^12.4.0",
    "firebase-admin": "^13.5.0",
    "gliner": "^0.0.19",
    "helmet": "^8.1.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.26.0",
    "lumaai": "^1.18.2",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "onnxruntime-node": "1.19.2",
    "openai": "^6.42.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.4",
    "replicate": "^1.4.0",
    "sharp": "^0.34.5",
    "stripe": "^17.7.0",
    "three": "^0.182.0",
    "tsx": "^4.20.6",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  },
  "overrides": {
    "onnxruntime-node": "1.19.2",
    "@xenova/transformers": {
      "onnxruntime-node": "1.19.2",
      "sharp": "0.34.5"
    },
    "@huggingface/transformers": {
      "onnxruntime-node": "1.19.2",
      "sharp": "0.34.5"
    },
    "baseline-browser-mapping": "2.9.18"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/lodash": "^4.17.17",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "@types/three": "^0.182.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.37.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-check": "^4.5.2",
    "globals": "^15.15.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.4.32",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "dev": "vite --config config/build/vite.config.ts",
    "server": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "server:dev": "tsx watch --tsconfig server/tsconfig.json --clear-screen --exclude \"**/*.test.ts\" --exclude \"**/__tests__/**\" --exclude \"**/models/*.onnx\" server/index.ts",
    "download-models": "bash scripts/download-models.sh",
    "upload-models": "bash scripts/upload-models.sh",
    "start": "tsx scripts/dev/start.ts",
    "restart": "lsof -ti :3001 | xargs kill -9 2>/dev/null || true && lsof -ti :5173 | xargs kill -9 2>/dev/null || true && npm start",
    "build": "NODE_ENV=production vite build --config config/build/vite.config.ts",
    "preview": "vite preview --config config/build/vite.config.ts",
    "lint": "eslint . --config config/lint/eslint.config.js --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix --config config/lint/eslint.config.js --cache --cache-location node_modules/.cache/eslint/",
    "test": "vitest --config config/test/vitest.unit.config.js",
    "test:integration": "vitest run --config config/test/vitest.integration.config.js",
    "test:unit": "vitest run --config config/test/vitest.unit.config.js",
    "eval:golden-set": "tsx --tsconfig server/tsconfig.json scripts/evaluation/golden-set-relaxed-f1.ts",
    "eval:golden-set:bless": "tsx --tsconfig server/tsconfig.json scripts/evaluation/golden-set-relaxed-f1.ts --bless",
    "eval:improve-wording": "tsx --tsconfig server/tsconfig.json scripts/evaluation/improve-wording.ts",
    "test:e2e": "playwright test --config config/test/playwright.config.js",
    "typecheck": "bash scripts/typecheck.sh",
    "verify": "bash scripts/verify.sh"
  }
}
