{
  "compilerOptions": {
    // === Module System ===
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    // === Strictness (ALL ON) ===
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "useUnknownInCatchVariables": true,

    // === Additional Strictness ===
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,

    // === Migration Support ===
    "allowJs": true,
    "checkJs": false,

    // === Output ===
    "noEmit": true,
    "skipLibCheck": true,
    "declaration": false,

    // === Path Aliases ===
    "baseUrl": ".",
    "paths": {
      "@/*": ["client/src/*"],
      "@/components/*": ["client/src/components/*"],
      "@/hooks/*": ["client/src/hooks/*"],
      "@/types/*": ["client/src/types/*"],
      "@/utils/*": ["client/src/utils/*"],
      "@/api/*": ["client/src/api/*"],
      "@components/*": ["client/src/components/*"],
      "@features/*": ["client/src/features/*"],
      "@hooks/*": ["client/src/hooks/*"],
      "@types/*": ["client/src/types/*", "server/src/types/*"],
      "@utils/*": ["client/src/utils/*", "server/src/utils/*"],
      "@config/*": ["client/src/config/*", "server/src/config/*"],
      "@services/*": ["server/src/services/*"],
      "@repositories/*": ["client/src/repositories/*"],
      "@infrastructure/*": ["server/src/infrastructure/*"],
      "@interfaces/*": ["server/src/interfaces/*"],
      "@llm/*": ["server/src/llm/*"],
      "@middleware/*": ["server/src/middleware/*"],
      "@routes/*": ["server/src/routes/*"],
      "@clients/*": ["server/src/clients/*"],
      "@server/*": ["server/src/*"],
      "@scripts/*": ["scripts/*"],
      "@migrations/*": ["scripts/migrations/*"],
      "@shared/*": ["shared/*"],
      "#shared/*": ["shared/*"],
      "@promptstudio/system/*": ["packages/promptstudio-system/src/*"]
    },

    // === React ===
    "jsx": "react-jsx",

    // === Type Roots ===
    "typeRoots": ["./node_modules/@types", "./client/src/types"]
  },
  "include": [
    "client/src/**/*",
    "server/src/**/*",
    "shared/**/*",
    "tests/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    // scripts/evaluation/span-labeling-evaluation.ts — EXCLUDED, dated 2026-09-18 (#117).
    // The LLM-as-judge span-labeling eval is FROZEN tooling: its only CI path is
    // the `quality-gate` job in .github/workflows/test.yml (FROZEN 2026-08-07 —
    // "does not run, does not gate merges"), and the related quality-judge.yml has
    // its cron disabled — both parked with the PostHog measurement program
    // (ADR-0002, zero users). Operationally it is superseded by the deterministic
    // relaxed-F1 golden-set gate (scripts/evaluation/golden-set-relaxed-f1.ts). It
    // carries 32 pre-existing type errors under this config; fixing them means
    // reworking frozen tooling for no live reader, which #117 explicitly declines.
    // UN-FREEZE: when the measurement program thaws (re-enable the test.yml
    // quality-gate / quality-judge.yml cron), fix its types and remove this entry.
    "scripts/evaluation/span-labeling-evaluation.ts"
  ]
}
