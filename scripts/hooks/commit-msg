#!/usr/bin/env bash
set -euo pipefail

# commit-msg hook: delegates to the single-source bugfix check
# (scripts/hooks/check-bugfix-test.sh) — fix commits need a regression test
# in a *.regression.test.* file, and changed regression tests must pass the
# mock-boundary quality check.

if [ -d "/opt/homebrew/bin" ]; then
  export PATH="/opt/homebrew/bin:$PATH"
elif [ -d "/usr/local/bin" ]; then
  export PATH="/usr/local/bin:$PATH"
fi

exec bash "$(git rev-parse --show-toplevel)/scripts/hooks/check-bugfix-test.sh" "$1"
